{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-after-commit.sh\"",
            "timeout": 60,
            "statusMessage": "Pushing to origin..."
          }
        ]
      }
    ]
  }
}
