{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "app",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8000"
      ],
      "port": 8000,
      "env": {
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "file",
        "QUEUE_CONNECTION": "sync"
      }
    }
  ]
}
