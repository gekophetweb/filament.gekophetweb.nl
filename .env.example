APP_NAME="Filament Spools"
APP_ENV=production
# Generated on the first container start into storage/app/.env.local (the
# installation's own settings file, which wins over this one).
APP_KEY=
APP_DEBUG=false
APP_URL=https://filament.gekophetweb.nl

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=filament
DB_USERNAME=filament
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=720

# Must be the frontend subnet from docker-compose.yml, never *
TRUSTED_PROXIES=172.28.0.0/24

# IP allow-lists (CIDR, IPv4/IPv6, comma separated, * = any address). Empty = block all in production.
ALLOWED_IPS_WEB=
ALLOWED_IPS_API=
ALLOWED_IPS_MCP=

# API/MCP rate limits per user (shared by all their tokens). Defaults shown.
# RATE_LIMIT_API_IP_PER_MINUTE=300
# RATE_LIMIT_API_READ_PER_MINUTE=120
# RATE_LIMIT_API_WRITE_PER_MINUTE=30
# RATE_LIMIT_API_WRITE_PER_DAY=1000
# RATE_LIMIT_MCP_PER_MINUTE=60
# MAX_TOKENS_PER_USER=10

# SSO and the IP allow-lists above are normally set by the first-run setup wizard
# (http://127.0.0.1:8000/setup, link in `docker compose logs app`). It writes them to
# storage/app/.env.local in the app storage volume, not to this file.
# SSO_PROVIDER=oidc works with any OpenID Connect IdP (Keycloak, Authentik,
# Entra ID: https://login.microsoftonline.com/<tenant>/v2.0, Google: https://accounts.google.com).
# Built-in Socialite drivers (google, github, ...) also work; then SSO_ISSUER is unused.
SSO_PROVIDER=oidc
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://filament.gekophetweb.nl/auth/callback
# Comma separated: full emails and/or domains starting with @, or * for open sign-up
# (anyone with a verified email at the provider). Empty = nobody can sign in.
SSO_ALLOWED_EMAILS=

OCTANE_SERVER=frankenphp

CLOUDFLARE_TUNNEL_TOKEN=
