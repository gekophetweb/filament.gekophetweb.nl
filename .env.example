APP_NAME="Filament Spools"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://filament.gekophetweb.nl

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=filament
DB_USERNAME=filament
DB_PASSWORD=change-me

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=720

# Must be the frontend subnet from docker-compose.yml, never *
TRUSTED_PROXIES=172.28.0.0/24

# IP allow-lists (CIDR, IPv4/IPv6, comma separated). Empty = block all in production.
ALLOWED_IPS_WEB=
ALLOWED_IPS_API=
ALLOWED_IPS_MCP=

# SSO. SSO_PROVIDER=oidc works with any OpenID Connect IdP (Keycloak, Authentik,
# Entra ID: https://login.microsoftonline.com/<tenant>/v2.0, Google: https://accounts.google.com).
# Built-in Socialite drivers (google, github, ...) also work; then SSO_ISSUER is unused.
SSO_PROVIDER=oidc
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://filament.gekophetweb.nl/auth/callback
# Comma separated: full emails and/or domains starting with @. Empty = nobody can sign in.
SSO_ALLOWED_EMAILS=

OCTANE_SERVER=frankenphp

CLOUDFLARE_TUNNEL_TOKEN=
