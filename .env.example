APP_NAME="Filament Spools"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://filament.gekophetweb.nl

LOG_CHANNEL=stderr

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=filament
DB_USERNAME=filament
DB_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PASSWORD=change-me
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Must be the frontend subnet from docker-compose.yml, never *
TRUSTED_PROXIES=172.28.0.0/24

# IP allow-lists (CIDR, comma separated). Empty = block all in production.
ALLOWED_IPS_WEB=
ALLOWED_IPS_API=
ALLOWED_IPS_MCP=

# SSO (Socialite)
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://filament.gekophetweb.nl/auth/callback
SSO_ALLOWED_EMAILS=

CLOUDFLARE_TUNNEL_TOKEN=
